<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.teaching</groupId>
    <artifactId>java-zero-to-hero</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Java Zero to Hero</name>
    <description>
        Single-project teaching repository. Domain-based packages under one src tree.
        No frameworks. Runnable demos. Java 21.
    </description>

    <!-- =========================================================
         Global properties
    ========================================================= -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Dependency versions: change once, applies everywhere -->
        <junit.version>5.11.4</junit.version>
        <junit.platform.version>1.11.4</junit.platform.version>
        <mysql.version>9.1.0</mysql.version>
        <h2.version>2.3.232</h2.version>
        <sqlite.version>3.50.3.0</sqlite.version>

        <!-- Plugin versions -->
        <compiler.plugin.version>3.13.0</compiler.plugin.version>
        <surefire.plugin.version>3.5.2</surefire.plugin.version>
        <exec.plugin.version>3.3.0</exec.plugin.version>

        <!--
            The task folder that exec:java@task and exec:java@tests run.
            Set it on the command line, for example:
            mvn -q compile exec:java@task -Dtask=05_classes/starter
        -->
        <task>01_bookshelf/solution</task>
    </properties>

    <!-- =========================================================
         Dependencies
    ========================================================= -->
    <dependencies>

        <!-- JUnit 5: test scope only -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            JUnit console launcher: runs the task 11 tests and prints the name of
            every test it runs (the Maven test report only lists failures).
        -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-console</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            H2: embedded, pure-Java, zero-setup database.
            Used for all databases-domain demos (in-memory mode, no server needed).
            H2 syntax is largely MySQL-compatible; swapping the JDBC URL and driver
            is all that is required to point the same DAO code at a real MySQL instance.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
        </dependency>

        <!--
            MySQL JDBC driver: kept here as reference for students who want to
            connect to a live MySQL 8+ server after completing the H2 demos.
            Change DbConnection.URL + credentials; the DAO code is unchanged.
            Requires MySQL 8+ running locally. Credentials go in
            src/main/resources/databases/db.properties (git-ignored).
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
        </dependency>

        <!--
            SQLite JDBC driver: task 10 (tasks/10_sqlite) keeps the library in a
            SQLite file. The driver carries SQLite itself, so nothing else is installed.
        -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

    </dependencies>

    <!-- =========================================================
         Build
    ========================================================= -->
    <build>
        <plugins>

            <!--
                The default executions compile src/main/java and src/test/java.

                The extra executions compile the practical tasks. Every task folder
                (tasks/NN_name/starter and tasks/NN_name/solution) is a small program
                of its own with a class called Main, so each one is compiled on its
                own into target/tasks/NN_name/starter or .../solution, during the
                compile phase. They use the testCompile goal so the task 11 tests can
                see JUnit, and so the jar this project builds is left alone.
                A task that does not compile fails the whole build, exactly like a
                broken file under src.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
                <executions>
                    <execution>
                        <id>task-01_bookshelf-starter</id>
