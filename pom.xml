            </plugin>

            <!--
                Surefire 3.x detects JUnit 5 automatically.
                useModulePath=false: avoids module-info.java complexity.
                The second execution also runs the task 11 solution tests, so
                mvn test proves them. The task 11 starter tests fail on purpose
                until they are written, so they are compiled but not run here.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <id>task-11-solution-tests</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <testClassesDirectory>${project.build.directory}/tasks/11_testing/solution</testClassesDirectory>
                            <reportsDirectory>${project.build.directory}/surefire-reports/task-11</reportsDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                Run any demo from the command line:
                mvn exec:java -Dexec.mainClass="com.teaching.basics.DatatypeRunner"

                Run a practical task (see tasks/README.md):
                mvn -q compile exec:java@task -Dtask=01_bookshelf/solution
                mvn -q compile exec:java@task -Dtask=08_persistence/solution -Dexec.args="tasks/data"

                Run the task 11 tests with every test name listed:
                mvn -q compile exec:java@tests -Dtask=11_testing/solution

                addOutputToClasspath=false: a task runs from target/tasks/... only,
                never from target/classes. IntelliJ IDEA compiles every task folder
                into target/classes when you build in the IDE, so an old Main or Book
                class left there would otherwise run instead of the task you asked for.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <executions>
                    <execution>
                        <id>task</id>
                        <configuration>
                            <mainClass>Main</mainClass>
                            <addOutputToClasspath>false</addOutputToClasspath>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.build.directory}/tasks/${task}</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </execution>
                    <execution>
                        <id>tests</id>
                        <configuration>
                            <mainClass>org.junit.platform.console.ConsoleLauncher</mainClass>
                            <classpathScope>test</classpathScope>
                            <addOutputToClasspath>false</addOutputToClasspath>
                            <arguments>
                                <argument>execute</argument>
                                <argument>--disable-banner</argument>
                                <argument>--details=tree</argument>
                                <argument>--fail-if-no-tests</argument>
                                <argument>--scan-classpath=${project.build.directory}/tasks/${task}</argument>
                            </arguments>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.build.directory}/tasks/${task}</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- =========================================================
         Profiles
    ========================================================= -->
    <profiles>

        <!--
            IntelliJ IDEA only: never active in a command-line build.
            IntelliJ turns each task folder into a module of its own (from the
            compiler executions above), so every starter and solution gets code
            completion with no setup. Those modules only see compile-scope
            dependencies, though, so the task 11 tests could not find JUnit.
            This profile switches itself on during IntelliJ's Maven import
            (IntelliJ sets the idea.maven.embedder.version property there) and
            makes JUnit visible to the task modules in the IDE.
        -->
        <profile>
            <id>intellij-task-modules</id>
            <activation>
                <property>
                    <name>idea.maven.embedder.version</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter</artifactId>
                    <version>${junit.version}</version>
                    <scope>provided</scope>
                </dependency>
                <dependency>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-console</artifactId>
                    <version>${junit.platform.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>

    </profiles>

</project>
